a = 1, 2, 3
b = 1, 2, Z[7~9]
d = {}
d["a"] = 1
d["bb"] = 2
say "countset=" + str(count(a))
say "countmixed=" + str(count(b))
say "countmixed_size=" + str(size(b))
say "countstr=" + str(count("hello"))
say "countarr=" + str(count([1, 2, 3]))
say "countdict=" + str(count(d))
say "countint=" + str(count(42))
say "countfloat=" + str(count(3.7))
say "countbool=" + str(count(true))
say "countnil=" + str(count(nil))
say "countZ=" + str(count(Z))
say "sizeint=" + str(size(42))
say "sizefloat=" + str(size(3.7))
say "sizeneg=" + str(size(-5))
say "countneg=" + str(count(-5))
say "sizestr=" + str(size("hello"))
say "sizearr=" + str(size([1, 2, 3]))
say "sizedict=" + str(size(d))
say "sizeZ=" + str(size(Z))
say "multisize=" + str(size(5, 5, 5))
say "multilen=" + str(len(9))
say "multicount=" + str(count(7, 8))
