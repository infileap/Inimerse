# 测试程序1:基础功能
name = "inimerse"
ver = 1.5
x = 10
y = 20
say "hello " + name
say x + y * 2
if ver > 1 and x > 5 {
    say "big"
} else {
    say "small"
}
items = [1, 2, 3]
say len(items)
for i in items {
    say "item " + str(i)
}
d = {"k": "v", "n": 42}
say d["k"]
say d["n"]
i = 0
while i < 3 {
    say "loop " + str(i)
    i = i + 1
}
stop all
