# lexer.im — inimerse 词法分析器(自举解释器第一部分)
# Token = {"k": "id"|"num"|"str"|"op"|"eof", "v": 文本, "line": 行号}
# 注意:
#   1. 字符串解转义(与 C 前端一致):支持 \n \t \r \\ \" \0;其余反斜杠序列
#      保持字面(反斜杠+字符);\0 之后截断,因为运行时字符串是 C 字符串
#   2. 支持 # 行注释和 #[...] 块注释; 也支持 // 行注释(与 C 前端一致,
#      见 selfhost/compiler.im 里那六行 // 注释:自举词法器必须读得进自己的源码)
#   3. 无 continue,用 elif 链组织互斥分支

func is_digit(c) {
    return c >= "0" and c <= "9"
}

func is_alpha(c) {
    return (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_"
}

func is_alnum(c) {
    return is_digit(c) or is_alpha(c)
}

# 运算符表:多字符在前(优先匹配)
ops = ["==", "!=", "<=", ">=", "..", "->",
       "+", "-", "*", "/", "%", "<", ">", "=", "!",
       "(", ")", "{", "}", "[", "]", ",", ";", ":", "."]

func lex(src) {
    tokens = []
    pos = 0
    line = 1
    n = len(src)
    nl = chr(10)
    tab = chr(9)
    cr = chr(13)
    quote = chr(34)
    while pos < n {
        c = src[pos]
        if c == nl {
            line = line + 1
            pos = pos + 1
        } elif c == " " or c == tab or c == cr {
            pos = pos + 1
        } elif c == "#" {
            # 注释
            if pos + 1 < n and src[pos + 1] == "[" {
                # 块注释 #[...] 支持嵌套
                depth = 1
                pos = pos + 2
                while pos < n and depth > 0 {
                    if src[pos] == "[" {
                        depth = depth + 1
                    } elif src[pos] == "]" {
                        depth = depth - 1
                    } elif src[pos] == nl {
                        line = line + 1
                    }
                    pos = pos + 1
                }
            } else {
                # 行注释:到行尾
                while pos < n and src[pos] != nl {
                    pos = pos + 1
                }
            }
        } elif c == "/" and pos + 1 < n and src[pos + 1] == "/" {
            # // 行注释:到行尾(与 C 前端一致;非 ASCII 字节一并跳过,
            # 所以注释里写中文/§ 不会触发"无法识别的字符")
            pos = pos + 2
            while pos < n and src[pos] != nl {
                pos = pos + 1
            }
        } elif is_alpha(c) {
            # 标识符 / 关键字
            bpos = pos
            while pos < n and is_alnum(src[pos]) {
                pos = pos + 1
            }
            push(tokens, {"k": "id", "v": substr(src, bpos, pos - bpos), "line": line})
        } elif is_digit(c) {
            # 数字
            bpos = pos
            while pos < n and (is_digit(src[pos]) or src[pos] == ".") {
                pos = pos + 1
            }
            push(tokens, {"k": "num", "v": substr(src, bpos, pos - bpos), "line": line})
        } elif c == quote {
            # 字符串:解转义,与 C 前端(src/lexer/lexer.c)一致
            # 支持 \n \t \r \\ \" \0;其余反斜杠序列保持字面(反斜杠+字符)
            pos = pos + 1
            buf = ""
            bs = chr(92)
            dq = chr(34)
            trunc = 0
            while pos < n and src[pos] != quote and trunc == 0 {
                ch = src[pos]
                if ch == bs and pos + 1 < n {
                    nxt = src[pos + 1]
                    known = 1
                    esc = ch
                    if nxt == "n" {
                        esc = chr(10)
                    } elif nxt == "t" {
                        esc = chr(9)
                    } elif nxt == "r" {
                        esc = chr(13)
                    } elif nxt == bs {
                        esc = bs
                    } elif nxt == dq {
                        esc = dq
                    } elif nxt == "0" {
                        # 运行时字符串是 C 字符串:\\0 之后的内容源码跑也看不到,
                        # 这里直接截断,与 C 前端同观感
                        trunc = 1
                        known = 2
                    } else {
                        known = 0
                    }
                    if known == 1 {
                        buf = buf + esc
                        pos = pos + 2
                    } elif known == 2 {
                        pos = pos + 2
                    } else {
                        buf = buf + ch
                        pos = pos + 1
                    }
                } else {
                    buf = buf + ch
                    pos = pos + 1
                }
            }
            if trunc == 1 {
                while pos < n and src[pos] != quote {
                    pos = pos + 1
                }
            }
            push(tokens, {"k": "str", "v": buf, "line": line})
            if pos < n {
                pos = pos + 1
            }
        } else {
            # 运算符(多字符优先)
            matched = 0
            for op in ops {
                if substr(src, pos, len(op)) == op {
                    push(tokens, {"k": "op", "v": op, "line": line})
                    pos = pos + len(op)
                    matched = 1
                    break
                }
            }
            if matched == 0 {
                say "lexer error: 无法识别的字符 [" + c + "] 第 " + str(line) + " 行"
                break
            }
        }
    }
    push(tokens, {"k": "eof", "v": "", "line": line})
    return tokens
}
