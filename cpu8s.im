# CPU: 8 threads sharing one global (lock contention)
global n
n = 0
thread s0 {
    global n
    k = 0
    while k < 2000000 {
        n = n + 1
        k = k + 1
    }
    say "s0 done"
}
start s0
thread s1 {
    global n
    k = 0
    while k < 2000000 {
        n = n + 1
        k = k + 1
    }
    say "s1 done"
}
start s1
