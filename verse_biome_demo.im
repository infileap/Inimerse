# verse_biome_demo.im - biome-driven world generation (demo of §21 API)
# shows: hierarchy setup, palette-based block variety, biome-aware nearby
# run: inimerse.exe verse_biome_demo.im

# ---------- 1. biome hierarchy (root -> region -> biome -> micro) ----------
surface = verse_biome_add("surface", 0, -1)
plains = verse_biome_add("plains_region", 1, surface)
forest = verse_biome_add("forest_region", 1, surface)
meadow = verse_biome_add("meadow_biome", 2, plains)
oak_forest = verse_biome_add("oak_forest", 2, forest)
grove = verse_biome_add("oak_grove", 3, oak_forest)

# ---------- 2. block palettes per biome (block diversity) ----------
verse_biome_palette(meadow, [1, 2, 3])       # grass, flower, stone
verse_biome_palette(oak_forest, [4, 5, 6])    # trunk, leaves, moss
verse_biome_palette(grove, [6, 7, 8])         # moss, berry, mushroom

# ---------- 3. generate a 16x16 area: blocks chosen from biome palette ----------
biome_at = {"x": -8, "y": -8, "w": 16, "h": 16, "b": meadow}
verse_biome_set(-8, -8, 0, 0, meadow)          # mark the region's biome at corner
i = 0
while i < 16 {
    j = 0
    while j < 16 {
        x = -8 + j
        y = -8 + i
        pal = verse_biome_info(meadow)["palette"]
        len_pal = len(pal)
        t = pal[(i * 16 + j) % len_pal]
        verse_block_set(x, y, 0, 0, t)
        j = j + 1
    }
    i = i + 1
}
say "blocks placed: " + verse_block_count()

# ---------- 4. entities with biome-aware nearby ----------
verse_entity_put("sheep", -2, -2)
verse_entity_put("wolf", -1, -3)
verse_entity_put("distant", 40, 40)
near = verse_nearby(-2, -2, 8)
say "nearby: " + near

# effective biome at a block (hierarchy ancestor chain for context)
say "biome at (-8,-8): " + verse_biome_name(verse_biome_get(-8, -8, 0, 0))
chain = verse_biome_ancestors(verse_biome_get(-8, -8, 0, 0))
names = []
for b in chain { push(names, verse_biome_name(b)) }
say "ancestor chain: " + names
say "biome-demo-ok"
