*.exp
*.obj
*.o
target/
build/
build-*/
/*.out
/inimerse
tools/__pycache__/
Infiverse_standard/src-tauri/target/

# Runtime and personal data
#
# Default deny.  Ignore the *contents* of every userdata/ directory and
# whitelist only the placeholder that keeps the directory in the tree.
#
# The previous version did the opposite: it ignored the directories and then
# re-included them with `!userdata/` so that `.gitkeep` survived.  Re-including
# a directory re-includes everything inside it, so every file the app wrote at
# runtime was committable and `git add -A` would take it without asking.  That
# is not a hypothetical: it nearly published a client secret
# (`userdata/oauth_secret_github.txt`) and then a live GitHub access token
# (`userdata/linked_accounts.json`), and the per-file patches added in response
# only ever covered the files someone happened to remember.  Denying the
# contents makes the safe answer the default, so a new runtime artifact is
# protected before anyone knows it exists.
userdata/*
!userdata/.gitkeep
Infiverse_standard/userdata/*
!Infiverse_standard/userdata/.gitkeep
Infiverse_standard/src-tauri/userdata/*
!Infiverse_standard/src-tauri/userdata/.gitkeep
# Defence in depth: these two names are credentials wherever they land, not
# only in the three directories above.
oauth_secret_*.txt
linked_accounts.json
**/messages/
**/wv2data/
*.bin
*.seed

# Logs, caches and temporary probes
*.log
*.tmp
*.bak
*.old
*.cache
tools/*.wasm
# Engine asset cache written by verse_pack's cache_put (src/mod/verse_dist_mod.c);
# universe/ has tracked entries, this subdirectory is generated.
universe/_cache/
_wv2sdk/
app/*WebView2/
app/wv2data/

# Local/editor files
.vs/
.vscode/
*.user
*.suo
desktop.ini

# Local OAuth/config secrets
oauth_*.json
oauth_*.bin
*.secret
.env
.env.*
!.env.example

# Local session artifacts
.zcode/
codex-reconnect-fix/
# Coordinator's own scratch: the kickoff/review prompts pasted into another
# session.  Not repository content.
.handoff/
# Leftover root from a `verse_layer_probe` run against a scratch directory.
verse_layer_probe_root/
# Per-session research scratch directory (not repository content).
# NB: this line is hygiene.  The `links` gate no longer scans untracked files at
# all (tools/check_links.py enumerates `git ls-files`), so a scratch directory
# cannot turn it red whether or not it is listed here.
.verify/

# Per-session git worktrees (tools/stream.sh)
.worktrees/

# npm cache used by `npm install --cache .npm-tmp` (the default ~/.npm is not
# writable in some sessions). Build input, not source.
.npm-tmp/

# Demo-recording pipeline migrated from the previous workspace root: pagecast
# source + patches, our test harnesses, finished clips and the MCP config.
# Local tooling and output, not Inimerse repository content.
video-pipeline/
