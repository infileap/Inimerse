*.bak
*.old
*.cache
tools/*.wasm
# Engine asset cache written by verse_pack's cache_put (src/mod/verse_dist_mod.c);
# universe/ has tracked entries, this subdirectory is generated.
universe/_cache/
_wv2sdk/
app/*WebView2/
app/wv2data/

