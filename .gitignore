# Build outputs and native artifacts
*.exe
*.dll
*.pdb
*.lib
*.exp
*.obj
*.o
target/
build/
build-*/
/*.out
/inimerse
tools/__pycache__/
Infiverse_standard/src-tauri/target/

# Runtime and personal data
userdata/
Infiverse_standard/userdata/
!userdata/
!Infiverse_standard/userdata/
!userdata/.gitkeep
!Infiverse_standard/userdata/.gitkeep
# The negations above un-ignore the directories wholesale, so they do not
# actually keep runtime state out.  These files are written on every run and
# must never be committed: a tracked stats.json from "Release Infiverse 0.2.0"
# is already in the history and shows up as a dirty file after any test run.
userdata/stats.json
Infiverse_standard/userdata/stats.json
Infiverse_standard/src-tauri/userdata/stats.json
# A client secret is written here by oauth_set_secret.  The two un-ignore rules
# above re-include the whole userdata directory to keep .gitkeep, so anything
# dropped in at runtime becomes committable -- and `git add -A` does exactly
# that without asking.  Never let a credential leave this machine.
oauth_secret_*.txt
Infiverse_standard/userdata/oauth_secret_*.txt
**/messages/
**/wv2data/
*.bin
*.seed

# Logs, caches and temporary probes
*.log
*.tmp
*.bak
*.old
*.cache
tools/*.wasm
# Engine asset cache written by verse_pack's cache_put (src/mod/verse_dist_mod.c);
# universe/ has tracked entries, this subdirectory is generated.
universe/_cache/
_wv2sdk/
app/*WebView2/
app/wv2data/

# Local/editor files
.vs/
.vscode/
*.user
*.suo
desktop.ini

# Local OAuth/config secrets
oauth_*.json
oauth_*.bin
*.secret
.env
.env.*
!.env.example

# Local session artifacts
.zcode/
codex-reconnect-fix/
# Coordinator's own scratch: the kickoff/review prompts pasted into another
# session.  Not repository content.
.handoff/
# Leftover root from a `verse_layer_probe` run against a scratch directory.
verse_layer_probe_root/
# Per-session research scratch directory (not repository content).
# NB: this line is hygiene.  The `links` gate no longer scans untracked files at
# all (tools/check_links.py enumerates `git ls-files`), so a scratch directory
# cannot turn it red whether or not it is listed here.
.verify/

# Per-session git worktrees (tools/stream.sh)
.worktrees/

# npm cache used by `npm install --cache .npm-tmp` (the default ~/.npm is not
# writable in some sessions). Build input, not source.
.npm-tmp/
