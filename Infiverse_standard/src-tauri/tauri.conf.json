{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Infiverse",
  "version": "0.2.1",
  "identifier": "com.infiverse.app",
  "build": {
    "frontendDist": "../src/ui"
  },
  "app": {
    "windows": [
      {
        "title": "Infiverse",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
