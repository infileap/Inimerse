# math_ext.im - 数学扩展插件（可 import 使用）
func fib(n) {
    if n <= 1 { return n }
    a = 0
    b = 1
    i = 2
    while i <= n {
        t = a + b
        a = b
        b = t
        i = i + 1
    }
    return b
}
func factorial(n) {
    r = 1
    i = 1
    while i <= n {
        r = r * i
        i = i + 1
    }
    return r
}
func is_prime(n) {
    if n < 2 { return false }
    i = 2
    while i * i <= n {
        if n % i == 0 { return false }
        i = i + 1
    }
    return true
}
