# set comprehension tests (13日20:40 版，无限源改为抛异常 2026-08-14)
evens = { x in N[1~20] | x % 2 == 0 }
say 4 in evens
say 5 in evens
say size(evens)
say min evens
say max evens
small = { x in N[1~10] | x > 5 }
say size(small)
say 6 in small
say 5 in small
big = { x in N[1~1000] | x % 3 == 0 }
say size(big)
say 999 in big
say 1000 in big
try {
    inf = { x in N | x > 10 }
    say "should not print"
} catch (e) {
    say "inf caught"
    say e
}
