say "sum_a: " + sum_a()

const g150 = 999
if g150 != 999 { say "FAIL: const lost" } else { say "PASS: const beyond 256" }

g200 be N : 42
g200 = 55
if g200 != 55 { say "FAIL: be g200" } else { say "PASS: be beyond 256" }

thread worker {
    global g210
    say "thread_high:" + g210
}
start worker
wait 0.05

# try/catch: catch var lands beyond 256
try {
    throw "boom"
} catch (e) {
    say "catch_var:" + e
}

say "BIG_TEST_DONE"