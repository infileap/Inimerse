# stress_cpu.im - CPU load: arithmetic + sets + dict hash, timed
t0 = usage()["time"]
# 1) int/float arithmetic 20M ops
s = 0
i = 0
while i < 5000000 {
    s = s + i * 3 - 2
    i = i + 1
}
# 2) set ops
a = Z[1~1000]
b = Z[500~2000]
i = 0
while i < 50000 {
    c = a * b
    i = i + 1
}
# 3) dict hash get/set churn (O(1) path)
d = {}
i = 0
while i < 20000 {
    d["k" + str(i % 500)] = i
    i = i + 1
}
i = 0
acc = 0
while i < 500000 {
    acc = acc + d["k" + str(i % 500)]
    i = i + 1
}
t1 = usage()["time"]
say "stress_cpu done: " + str(int((t1 - t0) * 1000)) + "ms s=" + str(s) + " acc=" + str(acc) + " mem=" + str(usage()["mem"])
