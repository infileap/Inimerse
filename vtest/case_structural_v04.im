config = {"kind": "not_found", "retry": 1}
envelope = {"error": {"kind": "not_found"}}
case config {
    {"kind": "permission_denied"}: say "bad"
    {"kind": "not_found"}: say "record-hit"
    _: say "other"
}
case envelope {
    {"error": {"kind": "not_found"}}: say "nested-hit"
    _: say "nested-other"
}
case config {
    {"kind": k, "retry": retries}: say k + ":" + retries
}
case config {
    {"missing": value}: say "bad-missing"
    _: say "missing-safe"
}
