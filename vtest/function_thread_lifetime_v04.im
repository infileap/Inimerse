# Function values keep their closure while crossing a thread message queue.
thread receiver {
    atomic_set("receiver_ready", 1)
    recv handler, 2
    say str(handler(4))
}

queued = x -> x + 5
atomic_set("receiver_ready", 0)
start receiver
ready_spins = 0
while atomic_get("receiver_ready") == 0 and ready_spins < 200 {
    wait 0.01
    ready_spins = ready_spins + 1
}
send receiver queued
join receiver

# A naturally finishing restart thread must release functions held in its
# register file before beginning the next iteration.
runs = 0
thread restart recycler {
    local_fn = x -> x + 1
    atomic_add("runs", local_fn(0))
}

start recycler
wait 0.35
kill recycler
join recycler
say "function-thread-lifetime-ok"
