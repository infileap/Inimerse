func break_in_finally() {
    i = 0
    while i < 2 {
        try {
            i = i + 1
        } finally {
            break
        }
    }
    return i
}

func continue_in_finally() {
    i = 0
    while i < 2 {
        try {
            i = i + 1
        } finally {
            continue
        }
        i = i + 100
    }
    return i
}

func return_then_break_in_finally() {
    i = 0
    while i < 2 {
        try {
            return 7
        } finally {
            break
        }
    }
    return 9
}

func return_then_continue_in_finally() {
    i = 0
    while i < 2 {
        try {
            return 8
        } finally {
            continue
        }
    }
    return 10
}

say break_in_finally()
say continue_in_finally()
say return_then_break_in_finally()
say return_then_continue_in_finally()
