values = [{"kind": "ok", "data": [11, {"code": 42}]}, "tail"]

case values {
    [{"kind": "ok", "data": [first, {"code": code}]}, tail]: say first + code
    _: say "nested-pattern-miss"
}

case values {
    [{"kind": "bad", "data": [_, {"code": 41}]}, _]: say "wrong-pattern"
    _: say "nested-fallback-ok kind=" + str(values[0]["kind"]) + " code=" + str(values[0]["data"][1]["code"])
}

nested_literal = [[1, 2]]
case nested_literal {
    [[a, b]]: say "nested-literal-ok a=" + str(a) + " b=" + str(b)
    _: say "nested-literal-miss"
}
