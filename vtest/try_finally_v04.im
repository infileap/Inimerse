# finally runs on both normal and caught-exception paths.
flag = 0
try {
    flag = flag + 1
} catch (e) {
    flag = flag + 10
} finally {
    flag = flag + 100
}
say flag
flag = 0
try {
    try {
        throw "rethrow-me"
    } finally {
        flag = flag + 100
    }
} catch (e) {
    say flag
    say e
}
try {
    throw "boom"
} catch (e) {
    flag = flag + 10
} finally {
    flag = flag + 1000
}
say flag
