# finally runs on both the normal path and the caught-exception path, and it
# still runs when the exception is re-thrown past it.
#
# The `finally ` prefixes exist so CTest can assert on the VALUES: `101` is a
# prefix of `1110`, and the engine's module/builtin echo puts other bare
# numbers in the combined output.
flag = 0
try {
    flag = flag + 1
} catch (e) {
    flag = flag + 10
} finally {
    flag = flag + 100
}
say "finally normal=" + str(flag)
flag = 0
try {
    try {
        throw "rethrow-me"
    } finally {
        flag = flag + 100
    }
} catch (e) {
    say "finally nested=" + str(flag)
    say "finally nested err=" + str(e)
}
try {
    throw "boom"
} catch (e) {
    flag = flag + 10
} finally {
    flag = flag + 1000
}
say "finally caught=" + str(flag)
