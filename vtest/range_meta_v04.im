# Metadata members must lower to the core builtins, even when the object is
# an identifier visible to namespace resolution.
range_meta_value = 42
range_meta_global be 0,1,2,3:0
if match(range_meta_value.type, "^int$") {
    if 5 in range_meta_value.range {
        if !(3000000000.0 in range_meta_value.range) {
            if match(range_meta_global.type, "^int$") {
                if range_meta_global in range_meta_global.range {
                    say "range-" + "meta-pass"
                } else { say "range-meta-fail:g-membership" }
            } else { say "range-meta-fail:g-type" }
        } else { say "range-meta-fail:large-int-bound" }
    } else { say "range-meta-fail:int-membership" }
} else { say "range-meta-fail:a-type" }
