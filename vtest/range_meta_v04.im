# Range metadata core builtin must expose the integer domain for int values.
range_meta_value = 42
if 5 in range(range_meta_value, -1) {
    if !(3000000000.0 in range(range_meta_value, -1)) {
        say "range-" + "meta-pass"
    } else { say "range-meta-fail:large-int-bound" }
} else { say "range-meta-fail:int-membership" }
