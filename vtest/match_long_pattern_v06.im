// A pattern longer than the translation buffer used to be silently cut,
// and the cut pattern is what ran.  "^" + N a"s + "$zzz" cannot match:
// "$" demands end-of-string and then a literal "zzz" must still follow.
// The old fixed buffer stopped at 2031 bytes, dropped "$zzz", and the
// remaining "^aaa..." matched a prefix -- a wrong answer shaped exactly
// like the right one, with no diagnostic.  The paired possible pattern
// ("^" + N a"s + "$") must stay true, so that a "always answer false"
// non-fix cannot pass this test.  See docs/AUDIT.md 1.64.
s2030 = ""
say "match-long 2030 impossible=" + match(s2030, "^" + "" + "$zzz")
say "match-long 2030 possible="   + match(s2030, "^" + "" + "$")
s3000 = ""
say "match-long 3000 impossible=" + match(s3000, "^" + "" + "$zzz")
say "match-long 3000 possible="   + match(s3000, "^" + "" + "$")
// short control: same shapes, no truncation possible
t = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
say "match-long 50 impossible=" + match(t, "^" + "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" + "$zzz")
say "match-long 50 possible="   + match(t, "^" + "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" + "$")
