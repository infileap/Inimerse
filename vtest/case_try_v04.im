# Native Result branch dispatch.
r = ok(42)
case try r {
    ok(v): say v
    err: say "err"
    _: say "other"
}
e = err("failure")
say result_error(e)
case try e {
    ok(v): say "bad"
    err(reason): say reason
}
case 5 {
    n | n > 10: say "bad-guard"
    n | n > 0: say "guard-ok"
    _: say "guard-fail"
}
type FileError = "not_found", "permission_denied"
ferr = err("not_found")
case try ferr {
    err(e) | e in FileError: say "file-error"
    err(e): say "other-error"
    ok(v): say "bad-ok"
}
