# entity_stress.im - 大量精灵压力基准（验证动态精灵表 + 批量更新成本）
# headless 模式运行；外部计时测墙钟
declare { mem 128MB, vram 64MB, time 30s }
gui_stage(480, 320)
say "STAGE1_CREATE"
n = 0
while n < 512 {
    c = gui_canvas(8, 8)
    if c >= 0 {
        gui_canvas_clear(c, 0x335577)
        gui_px(c, 4, 4, 0xCC3344)
        r = gui_canvas_sprite(c, "m" + n)
        if r == 1 { n = n + 1 } else { say "sprite fail at " + n }
    } else {
        say "canvas exhausted at " + n
        n = 512
    }
}
say "created=" + n
i = 0
while i < n {
    m = "m" + i
    gui_goto(m, (i % 24) * 20 + 10, (i / 24) * 20 + 10)
    i = i + 1
}
say "STAGE2_MOVE"
t = 0
while t < 60 {
    i = 0
    while i < n {
        m = "m" + i
        gui_move(m, 1)
        i = i + 1
    }
    t = t + 1
}
say "STAGE3_DONE"
wait 1
say "STRESS_DONE"
