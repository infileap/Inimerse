say "=== for x in arr 遍历 ==="
nums = [10, 20, 30]
for x in nums {
  say x
}
words = ["a", "bb", "ccc"]
for w in words {
  say w
}

say "=== join / split ==="
parts = ["hello", "world", "inimerse"]
s = join(parts, "-")
say s
back = split(s, "-")
say back
say len(back)
say split("1,2,3", ",")

say "=== 多维数组自动扩展 ==="
matrix = []
matrix[0][0] = 1
matrix[0][1] = 2
matrix[1][0] = 3
say matrix
say matrix[1][0]

say "=== 数组+循环组合 ==="
total = 0
for n in [5, 6, 7] {
  total = total + n
}
say total
stop all
