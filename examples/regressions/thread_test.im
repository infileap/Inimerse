# restart thread + thread to A tests
global i, j, hits
i = 0
j = 0
hits = 0
thread worker {
    global i
    i = 0
    while i < 2000000 {
        i = i + 1 }
    i = -1
}
start worker
wait 0.1
pause worker
say i
restart worker
wait 0.05
pause worker
say i
kill worker
say "restart done"

thread jumpy {
    global j, hits
    # `A: j = 0` is no longer a label either (see label_test.im); the block form
    # keeps A a jump target for `jumpy to A` below.  `hits` counts the passes
    # through A, so "A is still a label" is a deterministic assertion instead of
    # the spin count j, which cannot be compared between runs.
    A: {
        hits = hits + 1
        j = 0 }
    while j < 1000000 {
        j = j + 1 }
    j = -1
}
start jumpy
wait 0.05
pause jumpy
say "hits after start=" + str(hits)
jumpy to A
resume jumpy
wait 0.02
pause jumpy
say "hits after jump=" + str(hits)
kill jumpy
say "jump done"
