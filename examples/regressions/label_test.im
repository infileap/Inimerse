# label/continue/restart/thread-goto tests
# --- continue in while ---
i = 0
c = 0
while i < 10 {
    i = i + 1
    if i % 2 == 0 {
        continue }
    c = c + 1
}
say c
# --- continue in repeat ---
n = 0
s = 0
repeat 5 {
    n = n + 1
    if n == 2 {
        continue }
    s = s + 1
}
say s
# --- label block: to / break ---
x = 0
L: {
    x = x + 1
    if x < 3 {
        to L }
    break L
}
say x
# --- label on while: break A exits the while ---
y = 0
W: while y < 100 {
    y = y + 1
    if y >= 5 {
        break W }
}
say y
# --- label on case ---
z = 0
C: case 2 {
    1: z = 1
    2: z = 2
    else: z = 0
}
say z
# --- label with a real BACKWARD jump ---
# `M: m = m + 1` is no longer a label: after an identifier, `:` now starts the
# declaration `名字: 集合 [= 初值]` (docs/TYPESET_V06.md §3.1, docs/SYNTAX.md §6.3).
# A labelled single statement must be written as a block.
m = 0
M: { m = m + 1 }
if m < 3 {
    to M }
say m
# --- to SKIP jumps FORWARD, skipping k = 99 ---
k = 0
to SKIP
k = 99
SKIP: { k = k + 1 }
say k
say "done"
