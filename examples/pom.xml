<?xml version="1.0"?>
<!-- Maven equivalent of examples/build.gradle (roadmap §3.2). -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.inimerse</groupId>
  <artifactId>inimerse-native</artifactId>
  <version>0.5.0</version>
  <properties>
    <maven.compiler.source>8</maven.compiler.source>
    <maven.compiler.target>8</maven.compiler.target>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>generate-bindings</id>
            <phase>generate-sources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>python3</executable>
              <arguments>
                <argument>tools/bindgen.py</argument>
                <argument>examples/interface.def</argument>
                <argument>--language</argument><argument>java</argument>
                <argument>--out</argument>
                <argument>${project.build.directory}/generated-sources/inimerse/InimerseNative.java</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
