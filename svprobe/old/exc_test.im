# exception tests (M2)
try {
    say "in try"
    throw "boom"
    say "unreachable"
} catch (e) {
    say "caught"
    say e
}
say "after"
gamemode be 0,1,2,3:0
try {
    gamemode = 5
    say "should not print"
} catch (e) {
    say "be caught"
    say e
}
say gamemode
try {
    throw "outer"
} catch (e) {
    say "outer catch"
}
func boom() {
    throw "from func"
}
try {
    boom()
} catch (e) {
    say "cross func"
    say e
}
say "done"
