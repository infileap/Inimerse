# infinite-set interval representation + comprehension tests (2026-08-14, ASCII only)
# (,) = reals R ; (,a) = (-inf,a) ; (a,) = (a,+inf) ; [a~b] closed; endpoints may be empty

r = (,)
say 5 in r
say -3.5 in r
say "a" in r
say min r
say max r
say list(r)

a = (,5)
say 4 in a
say 5 in a
say 6 in a

b = (,5]
say 5 in b
say 6 in b

c = (5,)
say 6 in c
say 5 in c

d = [5,)
say 5 in d
say 4.5 in d

e = (0,1)
say 0 in e
say 0.5 in e
say 1 in e

f = [0,1)
say 0 in f
say 1 in f

g = (0,1]
say 0 in g
say 1 in g

h = [0~1]
say 0 in h
say 1 in h

i = [~5]
say -100 in i
say 5 in i
say 6 in i

j = [5~]
say 5 in j
say 100 in j
say -1 in j

# set algebra with intervals
k = (1,5) + (3,8)
say 2 in k
say 6 in k
say 3 in k

l = (0,2) * (1,3)
say 0.5 in l
say 1.5 in l
say 2.5 in l
say l == (1,2)

m = Z(,5]
say 3 in m
say 4.5 in m
say 5 in m
say 6 in m

n = Z(,5)
say 5 in n
say 4 in n

# subset relations with R
say N in (,)
say Z in (,)
say Z+ in (,)
say (,5] in (,)
say (,) in Z

o = size(1,2,3)
say o

p = list(Z[1~5])
say p

# comprehension over finite source
q = {x in Z[1~10] | x%2==0}
r2 = 2,4,6,8,10
say q == r2
say 4 in q
say 7 in q
say size(q)
say list(q)

src = 1,2,3,4
s = {x in src | x > 2}
r3 = 3,4
say s == r3

# comprehension over infinite source -> throws
try {
    t = {x in (,) | x > 5}
    say "should not print"
} catch (e) {
    say "caught infinite"
    say e
}

# be with real interval
gv be (0,10):5
say gv
try {
    gv = 11
    say "should not print"
} catch (e) {
    say "be caught"
    say e
}
say gv
say "done"
