// svprobe: OLD `be` shape — constraint must be live (baseline expectation)
// x be 0,1,2,3 : 2
x be 0,1,2,3: 2
say "init=" + str(x)
say "range=" + str(x.range)
x = 3
say "in-range 3 ok -> " + str(x)
try {
    x = 9
    say "DEFECT: out-of-range 9 was accepted, x=" + str(x)
} catch (e) {
    say "caught=" + str(e)
}
