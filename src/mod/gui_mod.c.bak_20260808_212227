    if (argc == 2) {   /* °´ id ×·¼Ó */
        id = (int)arg_num(vm, 1);
        char line[512] = ""; snprintf(line, sizeof line, "%s", arg_str(vm, 0));
        popn(vm, vm_cur_sp(vm) + 1);
        EnterCriticalSection(&G.lock);
        if (id >= 1 && id <= G.ctrlCount && G.ctrls[id - 1].type == CTRL_LOG) gui_log_append(&G.ctrls[id - 1], line);
        LeaveCriticalSection(&G.lock);
        push_int(vm, id); return 1;
    }
    int x = (int)arg_num(vm, argc - 1), y = (int)arg_num(vm, argc - 2);
    int w = (int)arg_num(vm, argc - 3), h = (int)arg_num(vm, argc - 4);
    char line[512] = ""; snprintf(line, sizeof line, "%s", arg_str(vm, argc - 5));
    popn(vm, vm_cur_sp(vm) + 1);
    EnterCriticalSection(&G.lock);
    GuiCtrl *c = NULL;
    for (int i = 0; i < G.ctrlCount; i++)
        if (G.ctrls[i].type == CTRL_LOG && G.ctrls[i].x == x && G.ctrls[i].y == y) { c = &G.ctrls[i]; id = i + 1; break; }
    if (!c && G.ctrlCount < MAX_CTRLS) {
        c = &G.ctrls[G.ctrlCount];
        memset(c, 0, sizeof *c);
        c->type = CTRL_LOG; c->x = x; c->y = y; c->w = w; c->h = h;
        id = ++G.ctrlCount;
    }
    if (c) gui_log_append(c, line);
    LeaveCriticalSection(&G.lock);
    push_int(vm, id); return 1;
}
