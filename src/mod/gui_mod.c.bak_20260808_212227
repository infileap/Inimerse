static int key_vk(const char *k) {
    if (!k) return 0;
    if (k[0] && k[1] == '\0') { if (k[0] >= 'a' && k[0] <= 'z') return k[0] - 32; return k[0]; }
    struct { const char *n; int vk; } map[] = {
        {"left",VK_LEFT},{"right",VK_RIGHT},{"up",VK_UP},{"down",VK_DOWN},
        {"space",VK_SPACE},{"enter",VK_RETURN},{"tab",VK_TAB},{"esc",VK_ESCAPE},
        {"backspace",VK_BACK},{"delete",VK_DELETE},{"shift",VK_SHIFT},{"ctrl",VK_CONTROL},
        {"alt",VK_MENU},{"caps",VK_CAPITAL},{"home",VK_HOME},{"end",VK_END},
        {"f1",VK_F1},{"f2",VK_F2},{"f3",VK_F3},{"f4",VK_F4},{"f5",VK_F5},{"f6",VK_F6},
        {"f7",VK_F7},{"f8",VK_F8},{"f9",VK_F9},{"f10",VK_F10},{"f11",VK_F11},{"f12",VK_F12},
        {NULL,0}
    };
    for (int i = 0; map[i].n; i++) if (strcmp(map[i].n, k) == 0) return map[i].vk;
    return 0;
}

