/* gui_scroll(id, delta): ÊÖ¶¯¹ö¶¯ÈÕÖ¾ÊÓÍ¼(Õý=ÏòÏÂ) */
static int builtin_gui_scroll(VM *vm) {
    int id = (int)arg_num(vm, 1), delta = (int)arg_num(vm, 0);
    popn(vm, vm_cur_sp(vm) + 1);
    if (!G.stageCreated) { ret(vm, 1); return 1; }
    EnterCriticalSection(&G.lock);
    if (id >= 1 && id <= G.ctrlCount && G.ctrls[id - 1].type == CTRL_LOG) {
        GuiCtrl *c = &G.ctrls[id - 1];
        int rows = 0; for (const char *p = c->text; *p; p++) if (*p == '\n') rows++;
