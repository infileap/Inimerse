static void edit_sel_norm(GuiCtrl *c) { if (c->selStart > c->selEnd) { int t = c->selStart; c->selStart = c->selEnd; c->selEnd = t; } }
static void edit_collapse_sel(GuiCtrl *c) { c->selStart = c->selEnd = c->cursor; }

static void edit_undo_push(GuiCtrl *c) {
    if (c->undoCount < MAX_UNDO) {
        c->undo[c->undoCount++] = strdup(c->editBuf);
    } else {
        free(c->undo[0]);
        memmove(c->undo, c->undo + 1, (MAX_UNDO - 1) * sizeof(char*));
        c->undo[MAX_UNDO - 1] = strdup(c->editBuf);
    }
    for (int i = 0; i < c->redoCount; i++) free(c->redo[i]);
    c->redoCount = 0;
}
static int edit_undo(GuiCtrl *c) {
    if (c->undoCount == 0) return 0;
    c->redo[c->redoCount++] = strdup(c->editBuf);
    char *snap = c->undo[--c->undoCount];
    strcpy(c->editBuf, snap); free(snap);
    c->cursor = (int)strlen(c->editBuf);
    edit_collapse_sel(c);
    return 1;
}
static int edit_redo(GuiCtrl *c) {
    if (c->redoCount == 0) return 0;
    c->undo[c->undoCount++] = strdup(c->editBuf);
    char *snap = c->redo[--c->redoCount];
    strcpy(c->editBuf, snap); free(snap);
    c->cursor = (int)strlen(c->editBuf);
    edit_collapse_sel(c);
    return 1;
}
static void edit_free_undo(GuiCtrl *c) {
    for (int i = 0; i < c->undoCount; i++) free(c->undo[i]);
    for (int i = 0; i < c->redoCount; i++) free(c->redo[i]);
    c->undoCount = c->redoCount = 0;
}
