static void gui_log_append(GuiCtrl *c, const char *line) {
    if (!line[0]) return;
    size_t cur = strlen(c->text);
    if (cur > 0 && cur + 1 < sizeof c->text) { c->text[cur++] = '\n'; c->text[cur] = 0; }
    size_t llen = strlen(line);
    if (cur + llen + 1 >= sizeof c->text) {   /* ³¬ÏÞ: É¾³ýÇ°°ë */
        memmove(c->text, c->text + cur / 2, cur - cur / 2 + 1);
        cur = strlen(c->text);
    }
    memcpy(c->text + cur, line, llen); c->text[cur + llen] = 0;
    int rows = 0; for (const char *p = c->text; *p; p++) if (*p == '\n') rows++;
    int maxRows = (c->h - 8) / 22; if (maxRows < 1) maxRows = 1;
    if (rows + 1 > maxRows) c->scroll = rows + 1 - maxRows; else c->scroll = 0;
}
/* gui_log(x, y, w, h, text) »ò gui_log(id, text): ×·¼ÓÒ»ÐÐµ½¹ö¶¯ÈÕÖ¾ÊÓÍ¼ -> id */
