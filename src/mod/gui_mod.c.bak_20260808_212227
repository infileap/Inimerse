/* Ö´ÐÐÊ±¼äÉÏÏÞ¼ì²é(--time-limit / declare time), ¹© wait ÀàÄÚÖÃº¯ÊýÊ¹ÓÃ */
static int gui_vm_timeout(VM *vm) {
    if (vm->exec_timeout_ms > 0 && GetTickCount64() - vm->exec_start_ms > vm->exec_timeout_ms) {
        fprintf(stderr, "\n[¾¯¸æ] Ö´ÐÐ³¬¹ý %lu ºÁÃë£¬ÒÉËÆÎÞÏÞÑ­»·£¬ÒÑ×Ô¶¯ÍË³ö¡£\n", vm->exec_timeout_ms);
        return 1;
    }
    if (vm->limit_time > 0 && (double)(GetTickCount64() - vm->t_start) / 1000.0 > vm->limit_time) {
        fprintf(stderr, "\n[resource limit] time %.2fs exceeds declared limit %.2fs, auto-exit.\n",
                (double)(GetTickCount64() - vm->t_start) / 1000.0, vm->limit_time);
        return 1;
    }
    return 0;
}

/* ---------- ¿Ø¼þ»æÖÆ(ÊäÈë¿ò/¹ö¶¯ÈÕÖ¾ÊÓÍ¼) ---------- */
static void draw_ctrl_input(HDC dc, GuiCtrl *c) {
    RECT r = {c->x, c->y, c->x + c->w, c->y + c->h};
    HBRUSH wb = CreateSolidBrush(RGB(255, 255, 255));
    FillRect(dc, &r, wb); DeleteObject(wb);
    FrameRect(dc, &r, (HBRUSH)GetStockObject(c->focused ? BLACK_BRUSH : GRAY_BRUSH));
    HFONT f = gui_make_font();
    HGDIOBJ of = SelectObject(dc, f); SetBkMode(dc, TRANSPARENT);
    SetTextColor(dc, gui_color(G.textColor));
    size_t len = strlen(c->text);
    SIZE sz; GetTextExtentPoint32A(dc, c->text, (int)len, &sz);
    int xoff = 0;
    if (sz.cx > c->w - 8) xoff = sz.cx - (c->w - 8);   /* ³¬¿íÏÔÊ¾Ä©Î² */
    TextOutA(dc, c->x + 4 - xoff, c->y + 2, c->text, (int)len);
    if (c->focused && (GetTickCount64() / 500) % 2 == 0) {
        SIZE cs; GetTextExtentPoint32A(dc, c->text, c->cursor, &cs);
        int cx = c->x + 4 + cs.cx - xoff;
        if (cx >= c->x + 1 && cx <= c->x + c->w - 2) {
            RECT cr = {cx, c->y + 2, cx + 1, c->y + c->h - 2};
            FillRect(dc, &cr, (HBRUSH)GetStockObject(BLACK_BRUSH));
        }
    }
    SelectObject(dc, of); DeleteObject(f);
}
/* ÈÕÖ¾¿Ø¼þÐÐÊý(µ÷ÓÃÕßÐë³ÖÓÐ G.lock) */
static int gui_log_line_count(GuiCtrl *c) {
    int n = 1;
    for (int i = 0; c->text[i]; i++) if (c->text[i] == '\n') n++;
    return n;
}
static void draw_ctrl_log(HDC dc, GuiCtrl *c) {
    HRGN rgn = CreateRectRgn(c->x, c->y, c->x + c->w, c->y + c->h);
    SelectClipRgn(dc, rgn);
    HFONT f = gui_make_font();
    HGDIOBJ of = SelectObject(dc, f); SetBkMode(dc, TRANSPARENT);
    SetTextColor(dc, gui_color(G.textColor));
    const char *p = c->text;
    int line = 0, maxRows = (c->h - 8) / 22;
    if (maxRows < 1) maxRows = 1;
    while (*p) {
        const char *e = strchr(p, '\n');
        int len = e ? (int)(e - p) : (int)strlen(p);
        if (line >= c->scroll && line < c->scroll + maxRows) {
            char tmp[512]; int tl = len < 511 ? len : 511;
            memcpy(tmp, p, tl); tmp[tl] = 0;
            TextOutA(dc, c->x + 4, c->y + 4 + (line - c->scroll) * 22, tmp, tl);
        }
        if (!e) break;
        p = e + 1; line++;
    }
    SelectClipRgn(dc, NULL); DeleteObject(rgn);
    SelectObject(dc, of); DeleteObject(f);
}
