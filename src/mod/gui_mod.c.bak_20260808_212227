        int by1 = (int)(b->y - b->bmH / 2.0) + (b->boxSet ? b->boxY : 0);
        hit = (ax1 < bx1 + bw && bx1 < ax1 + aw && ay1 < by1 + bh && by1 < ay1 + ah);
        if (hit && ((a->flags & 0x2) || (b->flags & 0x2))) hit = 0; /* ghost skips collision */
    }
    LeaveCriticalSection(&G.lock);
    popn(vm, argc);
    push_int(vm, hit); return 1;
}
static int builtin_gui_key(VM *vm) {
    int argc = vm_cur_sp(vm) + 1;
    int vk = key_vk(arg_str(vm, 0));
    int down = (vk && G.keys[vk]);
    popn(vm, argc);
    push_int(vm, down); return 1;
}
static int builtin_gui_mouse_x(VM *vm) {
    popn(vm, vm_cur_sp(vm) + 1);
    POINT pt; GetCursorPos(&pt);
    if (G.hwnd) { ScreenToClient(G.hwnd, &pt); push_int(vm, pt.x); }
    else push_int(vm, 0);
    return 1;
}
static int builtin_gui_mouse_y(VM *vm) {
    popn(vm, vm_cur_sp(vm) + 1);
    POINT pt; GetCursorPos(&pt);
    if (G.hwnd) { ScreenToClient(G.hwnd, &pt); push_int(vm, pt.y); }
    else push_int(vm, 0);
    return 1;
}
static int builtin_gui_mouse_down(VM *vm) {
    popn(vm, vm_cur_sp(vm) + 1);
    push_int(vm, (GetAsyncKeyState(VK_LBUTTON) & 0x8000) ? 1 : 0); return 1;
}
static int builtin_gui_timer(VM *vm) {
    popn(vm, vm_cur_sp(vm) + 1);
    push_double(vm, GetTickCount64() / 1000.0 - G.t0); return 1;
}
static int builtin_gui_edge(VM *vm) {
    int argc = vm_cur_sp(vm) + 1;
    GuiSprite *sp = (argc >= 1) ? find_sprite(arg_str(vm, 0)) : find_sprite(bound_sprite(vm));
    int hit = 0;
    if (sp) {
        int w = sp->bmW * sp->size / 100, h = sp->bmH * sp->size / 100;
        hit = (sp->x < w / 2 || sp->x > G.W - w / 2 || sp->y < h / 2 || sp->y > G.H - h / 2);
    }
    LeaveCriticalSection(&G.lock);
    popn(vm, argc);
    push_int(vm, hit); return 1;
}
static int builtin_gui_rand(VM *vm) {
    int argc = vm_cur_sp(vm) + 1;
    int lo = (int)arg_num(vm, 1), hi = (int)arg_num(vm, 0);
    int v;
    if (hi <= lo) v = lo; else v = lo + rand() % (hi - lo + 1);
    popn(vm, argc);
    push_int(vm, v); return 1;
}
static int builtin_gui_self(VM *vm) {
    popn(vm, vm_cur_sp(vm) + 1);
    const char *b = bound_sprite(vm);
    ret_str(vm, b ? b : ""); return 1;
}
static int builtin_gui_sound(VM *vm) {
    int argc = vm_cur_sp(vm) + 1;
    char p[300] = ""; snprintf(p, sizeof p, "%s", arg_str(vm, 0));
    popn(vm, argc);
    if (p[0]) PlaySoundA(p, NULL, SND_FILENAME | SND_ASYNC);
    ret(vm, 1); return 1;
}
static int builtin_gui_music(VM *vm) {
    int argc = vm_cur_sp(vm) + 1;
    char p[300] = ""; snprintf(p, sizeof p, "%s", arg_str(vm, 0));
    popn(vm, argc);
    if (p[0]) PlaySoundA(p, NULL, SND_FILENAME | SND_ASYNC | SND_LOOP);
    ret(vm, 1); return 1;
}

