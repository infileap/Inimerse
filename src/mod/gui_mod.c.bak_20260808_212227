/* clicked(name): left button pressed this frame inside sprite box (edge) */
static int builtin_gui_clicked(VM *vm) {
    int argc = vm_cur_sp(vm) + 1;
    GuiSprite *b = (argc >= 1) ? find_sprite(arg_str(vm, 0)) : NULL;
    popn(vm, vm_cur_sp(vm) + 1);
    static int prev_lb = 0;
    int lb = (GetAsyncKeyState(VK_LBUTTON) & 0x8000) ? 1 : 0;
    int hit = 0;
    if (b && lb && !prev_lb) {
        POINT pt;
        GetCursorPos(&pt);
        if (G.hwnd) ScreenToClient(G.hwnd, &pt);
        int bw = b->boxSet ? b->boxW : b->bmW, bh = b->boxSet ? b->boxH : b->bmH;
        int bx1 = (int)(b->x - b->bmW / 2.0) + (b->boxSet ? b->boxX : 0);
        int by1 = (int)(b->y - b->bmH / 2.0) + (b->boxSet ? b->boxY : 0);
        hit = (pt.x >= bx1 && pt.x <= bx1 + bw && pt.y >= by1 && pt.y <= by1 + bh) ? 1 : 0;
    }
    prev_lb = lb;
    ret(vm, hit);
    return 1;
}

