/* fullscreen([0/1]): ÎÞ²Î=ÇÐ»»; 1=ÎÞ±ß¿òÈ«ÆÁ, 0=»¹Ô­ */
static int builtin_fullscreen(VM *vm) {
    int on = -1;
    if (vm_cur_sp(vm) >= 0) on = (int)arg_num(vm, 0);   /* ÓÐ²Î: ÏÔÊ½Ö¸¶¨ */
    popn(vm, vm_cur_sp(vm) + 1);
    if (!G.hwnd) { ret(vm, 1); return 1; }
    if (on < 0) on = !G.fullscreen;                      /* ÎÞ²Î: ÇÐ»» */
    if (on && !G.fullscreen) {
        GetWindowRect(G.hwnd, &G.restoreRect);
        G.restoreStyle = (LONG)GetWindowLongPtr(G.hwnd, GWL_STYLE);
        SetWindowLongPtr(G.hwnd, GWL_STYLE, (LONG_PTR)(WS_POPUP | WS_VISIBLE));
        int sw = GetSystemMetrics(SM_CXSCREEN), sh = GetSystemMetrics(SM_CYSCREEN);
        SetWindowPos(G.hwnd, HWND_TOP, 0, 0, sw, sh, SWP_SHOWWINDOW);
        G.fullscreen = 1;
    } else if (!on && G.fullscreen) {
        SetWindowLongPtr(G.hwnd, GWL_STYLE, G.restoreStyle);
        SetWindowPos(G.hwnd, HWND_TOP, G.restoreRect.left, G.restoreRect.top,
                     G.restoreRect.right - G.restoreRect.left, G.restoreRect.bottom - G.restoreRect.top,
                     SWP_SHOWWINDOW);
        G.fullscreen = 0;
    }
    ret(vm, 1);
    return 1;
}

