static HBITMAP load_bmp(const char *path, int *w, int *h) {
    if (w) *w = 0; if (h) *h = 0;
    HBITMAP b = (HBITMAP)LoadImageA(NULL, path ? path : "", IMAGE_BITMAP, 0, 0, LR_LOADFROMFILE);
    if (b) { BITMAP bi; GetObject(b, sizeof(bi), &bi); if (w) *w = bi.bmWidth; if (h) *h = bi.bmHeight; return b; }
    /* BMP Ê§°Ü: ??WIC ½âÂë PNG/JPG/GIF ?? Êä³ö 32bppBGRA(Ö§³ÖÍ¸Ã÷) */
    static int wic_ok = -1;
    if (wic_ok == -1) { CoInitializeEx(NULL, COINIT_APARTMENTTHREADED); wic_ok = 1; }
    IWICImagingFactory *fac = NULL;
    HRESULT hr = CoCreateInstance(&CLSID_WICImagingFactory, NULL, CLSCTX_INPROC_SERVER, &IID_IWICImagingFactory, (void**)&fac);
    if (FAILED(hr) || !fac) return NULL;
    WCHAR wpath[1024];
    MultiByteToWideChar(CP_UTF8, 0, path ? path : "", -1, wpath, 1024);
    IWICBitmapDecoder *dec = NULL;
    hr = fac->lpVtbl->CreateDecoderFromFilename(fac, wpath, NULL, GENERIC_READ, WICDecodeMetadataCacheOnLoad, &dec);
    if (FAILED(hr) || !dec) { fac->lpVtbl->Release(fac); return NULL; }
    IWICBitmapFrameDecode *frame = NULL;
    hr = dec->lpVtbl->GetFrame(dec, 0, &frame);
    if (FAILED(hr) || !frame) { dec->lpVtbl->Release(dec); fac->lpVtbl->Release(fac); return NULL; }
    UINT fw = 0, fh = 0;
    frame->lpVtbl->GetSize(frame, &fw, &fh);
    HBITMAP hb = NULL;
    if (fw > 0 && fh > 0) {
        BITMAPINFO bi = {0};
        bi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
        bi.bmiHeader.biWidth = (LONG)fw;
        bi.bmiHeader.biHeight = -(LONG)fh;
        bi.bmiHeader.biPlanes = 1;
        bi.bmiHeader.biBitCount = 32;
        bi.bmiHeader.biCompression = BI_RGB;
        void *bits = NULL;
        hb = CreateDIBSection(NULL, &bi, DIB_RGB_COLORS, &bits, NULL, 0);
        if (hb && bits) {
            IWICFormatConverter *fc = NULL;
            hr = fac->lpVtbl->CreateFormatConverter(fac, &fc);
            if (SUCCEEDED(hr) && fc) {
                hr = fc->lpVtbl->Initialize(fc, (IWICBitmapSource*)frame, &GUID_WICPixelFormat32bppBGRA,
                                            WICBitmapDitherTypeNone, NULL, 0, WICBitmapPaletteTypeMedianCut);
                if (SUCCEEDED(hr))
                    fc->lpVtbl->CopyPixels(fc, NULL, fw * 4, fw * 4 * fh, (BYTE*)bits);
                fc->lpVtbl->Release(fc);
            }
            if (w) *w = (int)fw; if (h) *h = (int)fh;
        }
    }
    frame->lpVtbl->Release(frame);
    dec->lpVtbl->Release(dec);
    fac->lpVtbl->Release(fac);
    return hb;
}
static void sprite_set_costume(GuiSprite *sp, int idx) {
    if (idx < 0 || idx >= sp->costumeCount) return;
    sp->currentCostume = idx;
    if (sp->bm) { DeleteObject(sp->bm); sp->bm = NULL; }
    sp->bm = load_bmp(sp->costumes[idx], &sp->bmW, &sp->bmH);
}
static void sprite_add_costume(GuiSprite *sp, const char *path) {
    if (!path || sp->costumeCount >= MAX_COSTUMES) return;
    snprintf(sp->costumes[sp->costumeCount], sizeof(sp->costumes[0]), "%s", path);
    sp->costumeCount++;
    if (sp->costumeCount == 1) sprite_set_costume(sp, 0);
}

/* °´µ±Ç°¿Í»§ÇøÊµ¼Ê³ß´çÍ¬²½ G.W/G.H ²¢ÖØ½¨ºó±¸»º³å¡£µ÷ÓÃÕß±ØÐëÒÑ³ÖÓÐ G.lock¡£ */
static void gui_sync_size(void) {
    if (!G.hwnd || !G.memDC) return;
    RECT cr;
    if (!GetClientRect(G.hwnd, &cr)) return;
    int nw = cr.right, nh = cr.bottom;
    if (nw < 16) nw = 16; if (nh < 16) nh = 16;
    if (nw == G.W && nh == G.H) return;
    G.W = nw; G.H = nh;
    if (G.memBM) { DeleteObject(G.memBM); G.memBM = NULL; }
    HDC hdc = GetDC(G.hwnd);
    G.memBM = CreateCompatibleBitmap(hdc, nw, nh);
    ReleaseDC(G.hwnd, hdc);
    SelectObject(G.memDC, G.memBM);
}

