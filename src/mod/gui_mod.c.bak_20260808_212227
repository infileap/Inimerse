static int builtin_gui_text(VM *vm) {
    int argc = vm_cur_sp(vm) + 1;
    const char *txt = arg_str(vm, vm_cur_sp(vm));   /* Ê×¸ö²ÎÊý = ÎÄ±¾ (sp-k ¼¼ÇÉ: stack[sp-sp]=stack[0]) */
    int x = 0, y = 0;
    if (argc >= 3) { x = (int)arg_num(vm, vm_cur_sp(vm) - 1); y = (int)arg_num(vm, vm_cur_sp(vm) - 2); }
    else if (argc == 2) { y = (int)arg_num(vm, vm_cur_sp(vm) - 1); }
    char local[256]; snprintf(local, sizeof local, "%s", txt ? txt : "");
    popn(vm, vm_cur_sp(vm) + 1);
    EnterCriticalSection(&G.lock);

    /* Ö¡»º´æ: °´ (x,y) Î»ÖÃÌæ»», Î´ÖØÌáµÄÎÄ±¾±£Áô(¼æÈÝÂýÖØÌá½Å±¾Èç workbench µÄ wait 0.05) */
    int slot = -1;
    for (int i = 0; i < G.textCount; i++) if (G.texts[i].x == x && G.texts[i].y == y) { slot = i; break; }
    if (slot < 0) {
        /* same content = same object: move it (no residue, no ring-overwrite) */
        for (int i = 0; i < G.textCount; i++) if (strcmp(G.texts[i].text, local) == 0) { slot = i; break; }
    }
    if (slot < 0) {
        if (G.textCount >= MAX_TEXTS) slot = G.textCount % MAX_TEXTS;  /* ÂúÔò»·ÐÎ¸²¸Ç×î¾É */
        else slot = G.textCount++;
    }
    snprintf(G.texts[slot].text, sizeof(G.texts[0].text), "%s", local);
    G.texts[slot].x = x; G.texts[slot].y = y;
    LeaveCriticalSection(&G.lock);
    ret(vm, 1); return 1;
}
