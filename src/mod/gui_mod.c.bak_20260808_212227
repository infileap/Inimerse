static int builtin_gui_clone(VM *vm) {
    popn(vm, vm_cur_sp(vm) + 1);
    const char *bname = bound_sprite(vm);
    VmThread *cur = vm_get_cur_thread();
    if (!bname || !cur || !G.stageCreated) { ret(vm, 0); return 1; }
    EnterCriticalSection(&G.lock);
    GuiSprite *src = find_sprite(bname);
    GuiSprite *cp = NULL;
    if (src) {
        cp = new_sprite();
        if (cp) {
            snprintf(cp->name, sizeof(cp->name), "%s#%d", bname, G.spriteCount);
            for (int i = 0; i < src->costumeCount; i++) sprite_add_costume(cp, src->costumes[i]);
            cp->x = src->x; cp->y = src->y; cp->dir = src->dir; cp->size = src->size; cp->visible = src->visible;
            cp->vx = src->vx; cp->vy = src->vy; cp->gravity = src->gravity;
            cp->boxX = src->boxX; cp->boxY = src->boxY; cp->boxW = src->boxW; cp->boxH = src->boxH; cp->boxSet = src->boxSet;
            cp->layer = src->layer;
        }
    }
    LeaveCriticalSection(&G.lock);
    if (!cp) { ret(vm, 0); return 1; }
    /* Æô¶¯¿ËÂ¡ÌåÏß??Í¬Ò»½Å±¾×Ö½Ú?? */
    VM *vm2 = cur->vm;
    int tidx = -1;
    for (int i = 0; i < VM_MAX_THREADS; i++) if (!vm2->threads[i] || vm2->threads[i]->finished) { tidx = i; break; }
    if (tidx < 0) { ret(vm, 0); return 1; }
    VmThread *nt = calloc(1, sizeof(VmThread));
    nt->vm = vm2; nt->code = cur->code; nt->ip = 0; nt->sp = -1; nt->tidx = tidx;
    nt->reg = malloc(VM_THREAD_REG_COUNT * sizeof(Value)); memset(nt->reg, 0, VM_THREAD_REG_COUNT * sizeof(Value));
    nt->R = nt->reg;
    CRITICAL_SECTION *ml = malloc(sizeof(CRITICAL_SECTION)); InitializeCriticalSection(ml); nt->msg_lock = ml;
    if (vm2->limit_threads > 0 && vm2->active_threads >= vm2->limit_threads) { ret(vm, 0); return 1; }
    vm2->threads[tidx] = nt;
    snprintf(G.threadSprite[tidx], sizeof(G.threadSprite[0]), "%s", cp->name);
    InterlockedIncrement(&vm2->active_threads);
    nt->os_handle = CreateThread(NULL, 0, thread_entry, nt, 0, NULL);
    ret(vm, 1); return 1;
}
