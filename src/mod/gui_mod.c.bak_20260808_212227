/* clipboard (GBK / CF_TEXT) */
static char *edit_clipboard_get(void) {
    if (!OpenClipboard(NULL)) return NULL;
    HANDLE h = GetClipboardData(CF_TEXT);
    char *out = NULL;
    if (h) {
        char *p = (char*)GlobalLock(h);
        if (p) { out = strdup(p); GlobalUnlock(h); }
    }
    CloseClipboard();
    return out;
}
static int edit_clipboard_set(const char *text) {
    int ok = 0;
    if (!OpenClipboard(NULL)) return 0;
    EmptyClipboard();
    size_t n = strlen(text);
    HANDLE h = GlobalAlloc(GMEM_MOVEABLE, n + 1);
    if (h) {
        char *p = (char*)GlobalLock(h);
        if (p) { memcpy(p, text, n + 1); GlobalUnlock(h); }
        ok = SetClipboardData(CF_TEXT, h) != NULL;
        if (!ok) GlobalFree(h);
    }
    CloseClipboard();
    return ok;
}
/* edit primitives */
static void edit_delete_range(GuiCtrl *c, int from, int to) {
    int len = (int)strlen(c->editBuf);
    if (from < 0) from = 0; if (to > len) to = len; if (from > to) { int t = from; from = to; to = t; }
    memmove(c->editBuf + from, c->editBuf + to, len - to + 1);
    c->cursor = from; edit_collapse_sel(c);
}
static void edit_insert_at(GuiCtrl *c, int pos, const char *text) {
    size_t tl = strlen(text), len = strlen(c->editBuf);
    if (len + tl >= sizeof c->editBuf) tl = sizeof c->editBuf - len - 1;
    if (tl == 0) { c->cursor = pos; edit_collapse_sel(c); return; }
    memmove(c->editBuf + pos + tl, c->editBuf + pos, len - pos + 1);
    memcpy(c->editBuf + pos, text, tl);
    c->cursor = pos + (int)tl; edit_collapse_sel(c);
}
static void edit_replace_sel(GuiCtrl *c, const char *text) {
    edit_sel_norm(c);
    if (c->selEnd > c->selStart) edit_delete_range(c, c->selStart, c->selEnd);
    edit_insert_at(c, c->cursor, text);
}
/* word boundaries (GBK-safe) */
static int edit_word_left(GuiCtrl *c, int pos) {
    while (pos > 0 && isspace((unsigned char)c->editBuf[pos-1])) pos--;
    while (pos > 0 && !isspace((unsigned char)c->editBuf[pos-1])) {
        if (pos >= 2 && gbk_trail((unsigned char)c->editBuf[pos-1]) && gbk_lead((unsigned char)c->editBuf[pos-2])) pos -= 2;
        else pos--;
    }
    return pos;
}
static int edit_word_right(GuiCtrl *c, int pos) {
    int len = (int)strlen(c->editBuf);
    while (pos < len && !isspace((unsigned char)c->editBuf[pos])) {
        if (gbk_lead((unsigned char)c->editBuf[pos]) && pos + 1 < len && gbk_trail((unsigned char)c->editBuf[pos+1])) pos += 2;
        else pos++;
    }
    while (pos < len && isspace((unsigned char)c->editBuf[pos])) pos++;
    return pos;
}
/* cursor pixel position within a line (for click/mouse positioning) */
static int edit_line_indent(GuiCtrl *c, int line) {
    int s, e; edit_line_range(c, line, &s, &e);
    int n = 0;
    while (s + n < e && (c->editBuf[s+n] == ' ' || c->editBuf[s+n] == '\t')) n++;
    return n;
}
static int edit_total_lines(GuiCtrl *c) {
    int n = 1;
    for (int i = 0; c->editBuf[i]; i++) if (c->editBuf[i] == '\n') n++;
    return n;
}
/* ÐÐºÅ -> ÐÐÊ×/ÐÐÎ²Æ«ÒÆ(²»º¬\n) */
static void edit_line_range(GuiCtrl *c, int line, int *start, int *end) {
    int cur = 0, s = 0, i = 0;
    while (1) {
        if (c->editBuf[i] == '\n' || c->editBuf[i] == 0) {
            if (cur == line) { *start = s; *end = i; return; }
            if (c->editBuf[i] == 0) { *start = s; *end = i; return; }
            s = i + 1; cur++;
        }
        i++;
    }
}
/* ¹â±êËùÔÚÐÐ(0»ù)ÓëÐÐÊ×Æ«ÒÆ */
static int edit_cursor_line(GuiCtrl *c, int *lineStart) {
    int line = 0, s = 0;
    for (int i = 0; i < c->cursor; i++) if (c->editBuf[i] == '\n') { s = i + 1; line++; }
    *lineStart = s;
    return line;
}
/* ¹â±êÒÆ¶¯(·½Ïò¼ü/ÐÐÊ×/ÐÐÎ²) */
static void edit_move_cursor(GuiCtrl *c, int vk) {
    int len = (int)strlen(c->editBuf);
    int cl, ls; cl = edit_cursor_line(c, &ls);
    int le; edit_line_range(c, cl, &ls, &le);
    if (vk == VK_LEFT) {
        if (c->cursor > ls) {
            c->cursor--;
            if (c->cursor > ls && gbk_trail((unsigned char)c->editBuf[c->cursor])
                && gbk_lead((unsigned char)c->editBuf[c->cursor - 1])) c->cursor--;
        } else if (cl > 0) {
            int s2, e2; edit_line_range(c, cl - 1, &s2, &e2);
            c->cursor = e2;
        }
    } else if (vk == VK_RIGHT) {
        if (c->cursor < le) {
            c->cursor++;
            if (c->cursor < le && gbk_trail((unsigned char)c->editBuf[c->cursor])
                && gbk_lead((unsigned char)c->editBuf[c->cursor - 1])) c->cursor++;
        } else if (c->cursor < len && c->editBuf[c->cursor] == '\n') {
            c->cursor++;
        }
    } else if (vk == VK_HOME) {
        c->cursor = ls;
    } else if (vk == VK_END) {
        c->cursor = le;
    } else if (vk == VK_UP || vk == VK_DOWN) {
        int col = c->cursor - ls;
        int target = (vk == VK_UP) ? cl - 1 : cl + 1;
        if (target < 0) { c->cursor = 0; return; }
        int tl = edit_total_lines(c);
        if (target >= tl) target = tl - 1;
        int s2, e2; edit_line_range(c, target, &s2, &e2);
        c->cursor = s2 + col;
        if (c->cursor > e2) c->cursor = e2;
    }
}
