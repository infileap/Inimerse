# A4: // 行注释（C/JS 习惯）
x = 5 // 行尾注释
say "x=" + x                  # 5

// 整行注释
y = 10 // 注释后还有内容
say "y=" + y                  # 10

z = 1 // 第一行注释
z = z + 1 // 第二行注释
say "z=" + z                  # 2

// 除法不受影响
d = 8 / 2
say "d=" + d                  # 4
e = 10 / 4
say "e=" + e                  # 2.5

// 字符串内 // 不受影响
u = "http://example.com/a//b"
say "u=" + u

// 注释可插在表达式行中? 注意: // 到行尾, 后续代码需换行
m = 1 + 2 // 行中注释
say "m=" + m                  # 3

say "A4_DONE"
